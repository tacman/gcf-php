{
    "name": "tacman/gcf-php",
    "description": "PHP implementation of GCF (Graph Compact Format), the AI-native wire format for structured data. Generic and graph profiles, delta encoding, session dedup, streaming.",
    "type": "library",
    "license": "MIT",
    "keywords": ["gcf", "llm", "agent", "wire-format", "serialization"],
    "homepage": "https://github.com/tacman/gcf-php",
    "bin": ["bin/gcf"],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gcf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gcf\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
